# =============================================================================
# StoopCraft outreach system -- example configuration
#
# Copy to .env and edit.  .env is git-ignored; never commit real credentials.
# Every value below is the SAFE DEFAULT: with this file as-is the whole system
# runs end to end against local fixtures and cannot send an email, cannot call
# a paid API, and cannot publish anything.
# =============================================================================

# --- storage ----------------------------------------------------------------
DATABASE_URL=sqlite:///data/outreach.db

ARTIFACT_ROOT=./artifacts
PREVIEW_ROOT=./previews
# Public base URL previews are served from once you publish them.
# Must be https:// and must not be localhost before any email can go out.
PREVIEW_BASE_URL=

# --- crawling ---------------------------------------------------------------
CRAWL_TIMEOUT_SECONDS=20
CRAWL_MAX_PAGES_PER_DOMAIN=5
CRAWL_DELAY_SECONDS=1
CRAWL_RESPECT_ROBOTS=true
# CRAWL_USER_AGENT=StoopCraftBot/1.0 (+https://your-domain/bot)
BROWSER_ENABLED=true
# Optional Lighthouse integration; the system never depends on it.
LIGHTHOUSE_ENABLED=false
LIGHTHOUSE_EXECUTABLE=lighthouse

# --- Google Places (metered; off by default) --------------------------------
GOOGLE_MAPS_API_KEY=
# Local monthly ceiling. Reaching it REFUSES further requests -- it does not
# merely warn. A code-level constant caps this at 5000 regardless.
GOOGLE_PLACES_MONTHLY_REQUEST_LIMIT=900

# --- AI providers -----------------------------------------------------------
# claude_cli uses the locally authenticated Claude Code CLI: no API key needed.
AI_PROVIDER=claude_cli
CLAUDE_EXECUTABLE=claude
CLAUDE_TIMEOUT_SECONDS=180
CLAUDE_MAX_RETRIES=1
# CLAUDE_MODEL=
CODEX_EXECUTABLE=codex

# --- scoring ----------------------------------------------------------------
SITE_SCORE_GOOD_THRESHOLD=70
SITE_SCORE_BORDERLINE_THRESHOLD=55
SITE_SCORE_REDESIGN_THRESHOLD=35
# Weights for combining deterministic and AI scores (normalised automatically).
DETERMINISTIC_SCORE_WEIGHT=0.6
AI_SCORE_WEIGHT=0.4
# Only these deterministic statuses are ever sent for AI review.
AI_SCORE_CANDIDATE_STATUSES=BORDERLINE,REDESIGN_CANDIDATE,STRONG_REDESIGN_CANDIDATE

# --- per-run bounds ---------------------------------------------------------
MAX_DISCOVERED_PER_RUN=100
MAX_SCANS_PER_RUN=100
MAX_AI_SCORES_PER_RUN=25
MAX_AI_EXTRACTIONS_PER_RUN=10
MAX_BUILDS_PER_RUN=10

# --- feature flags ----------------------------------------------------------
# The code for every feature below is fully implemented and tested.
# A flag set to false means the implementation simply does not execute.
FEATURE_REAL_DISCOVERY=false
FEATURE_AI_SCORING=false
FEATURE_AI_CONTENT_EXTRACTION=false
FEATURE_SITE_BUILDING=false
FEATURE_PREVIEW_PUBLISHING=false
FEATURE_EMAIL_COMPOSITION=false
FEATURE_GMAIL_SEND=false
FEATURE_REPLY_SYNC=false
FEATURE_SCHEDULER=false

# Master send switch. Sending needs BOTH this and FEATURE_GMAIL_SEND.
OUTREACH_SEND_ENABLED=false

# --- send volume ------------------------------------------------------------
OUTREACH_DAILY_SEND_LIMIT=15
# Defensive ceiling: the normal limit can never exceed it. Raising this beyond
# 100 additionally requires editing CODE_ABSOLUTE_MAX_DAILY_SEND_LIMIT.
OUTREACH_HARD_MAX_DAILY_SEND_LIMIT=50
OUTREACH_MIN_SECONDS_BETWEEN_SENDS=900

# --- send window ------------------------------------------------------------
OUTREACH_TIMEZONE=America/New_York
OUTREACH_SEND_WINDOW_START=09:00
OUTREACH_SEND_WINDOW_END=16:30
OUTREACH_SEND_DAYS=MON,TUE,WED,THU,FRI
# Also suppress every address at a domain once one address there opts out.
OUTREACH_SUPPRESS_BY_DOMAIN=true

# --- sender identity / compliance (required before production sending) ------
SENDER_NAME=
SENDER_COMPANY=StoopCraft
SENDER_POSTAL_ADDRESS=
# Defaults to the authenticated Gmail address when left blank.
SENDER_EMAIL=
SENDER_REPLY_TO=
UNSUBSCRIBE_INSTRUCTION=Reply STOP and I will not contact you again.

# --- Gmail OAuth ------------------------------------------------------------
# Path to the OAuth client secret JSON (Desktop app) from Google Cloud Console.
GMAIL_CLIENT_SECRET_PATH=
# Token is written here with 0600 permissions. Keep it out of git.
GMAIL_TOKEN_PATH=

# --- preview publishing -----------------------------------------------------
# local  -> copy into PREVIEW_PUBLISH_DIR (served by your existing web server)
# rsync  -> rsync to PREVIEW_RSYNC_TARGET over ssh
# null   -> publish nothing
PREVIEW_PUBLISHER=local
PREVIEW_PUBLISH_DIR=
PREVIEW_RSYNC_TARGET=
PREVIEW_SERVER_HOST=127.0.0.1
PREVIEW_SERVER_PORT=8800

# --- fixtures ---------------------------------------------------------------
FIXTURE_SERVER_HOST=127.0.0.1
FIXTURE_SERVER_PORT=8765

# --- logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=text
